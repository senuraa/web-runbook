{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "repository",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["pnpm exec eslint . --max-warnings=0", "node tools/check-line-length.mjs"],
        "parallel": false
      }
    },
    "format": {
      "command": "pnpm exec oxfmt --write .",
      "cache": false
    },
    "format-check": {
      "command": "pnpm exec oxfmt --check .",
      "cache": false
    },
    "pre-commit": {
      "command": "pnpm exec lint-staged --concurrent false",
      "cache": false
    },
    "test": {
      "command": "pnpm exec vitest run --exclude 'tests/integration/**'",
      "cache": false
    },
    "test-integration": {
      "command": "pnpm exec vitest run tests/integration",
      "cache": false
    },
    "test-all": {
      "cache": false
    },
    "typecheck": {
      "command": "pnpm exec tsc --project tsconfig.spec.json --noEmit",
      "cache": false
    },
    "test-ci": {
      "command": "node tools/testing/run-ci.mts",
      "cache": false
    }
  }
}
